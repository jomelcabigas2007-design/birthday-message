{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve birthday site",
            "type": "process",
            "command": "${env:WINDIR}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\serve.ps1"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "birthday-server",
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Birthday site listening at http://localhost:8080/$",
                    "endsPattern": "^Birthday site stopped\\.$"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        }
    ]
}
